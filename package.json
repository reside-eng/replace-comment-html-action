{
  "name": "@side/replace-comment-html-action",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "main": "./dist/index.mjs",
  "scripts": {
    "postinstall": "lefthook install",
    "build": "rimraf dist && node build.mjs",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write --error-on-warnings",
    "check:fix:staged": "biome check --write --error-on-warnings --staged --no-errors-on-unmatched",
    "format": "biome format --write --error-on-warnings",
    "format:check": "biome format --error-on-warnings",
    "lint": "biome lint --error-on-warnings",
    "lint:fix": "biome lint --write --error-on-warnings",
    "test": "yarn types:check && vitest run",
    "test:cov": "yarn types:check && vitest run --coverage",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "cheerio": "^1.0.0-rc.12",
    "common-tags": "^1.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@commitlint/cli": "^19.1.0",
    "@side/commitlint-config": "^1.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/common-tags": "^1.8.4",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "lefthook": "^2.1.8",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "yarn@4.1.1"
}
